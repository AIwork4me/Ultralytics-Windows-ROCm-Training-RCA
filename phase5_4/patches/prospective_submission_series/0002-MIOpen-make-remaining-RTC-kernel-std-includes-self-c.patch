+#pragma once
+
+/// \file Freestanding std::initializer_list for MIOpen runtime-compiled
+/// kernels (clang lowers braced-init-lists to field stores on this exact
+/// layout — verified by Phase-3 canary G57-7 on gfx1151/hiprtc 7.14).
+/// Selected by tensor_view.hpp only when no real <initializer_list> is
+/// reachable; see miopen_freestanding_type_traits.hpp for the rationale.
+
+#ifndef MIOPEN_HIP_RUNTIME_COMPILE
+#error "miopen_freestanding_initializer_list.hpp is for runtime-compiled kernels only"
+#endif
+
+#if !defined(__clang__)
+#error "miopen_freestanding_initializer_list.hpp relies on clang initializer_list lowering"
+#endif
+
+namespace std {
+
+template <class E>
+class initializer_list
+{
+    const E* __begin_;
+    __SIZE_TYPE__ __size_;
+
+    constexpr initializer_list(const E* b, __SIZE_TYPE__ s) noexcept : __begin_(b), __size_(s) {}
+
+public:
+    constexpr initializer_list() noexcept : __begin_(nullptr), __size_(0) {}
+
+    constexpr const E* begin() const noexcept { return __begin_; }
+    constexpr const E* end() const noexcept { return __begin_ + __size_; }
+    constexpr __SIZE_TYPE__ size() const noexcept { return __size_; }
+};
+
+} // namespace std
diff --git a/projects/miopen/src/kernels/radix.hpp b/projects/miopen/src/kernels/radix.hpp
index f8a91fed..99c29fda 100644
--- a/projects/miopen/src/kernels/radix.hpp
+++ b/projects/miopen/src/kernels/radix.hpp
@@ -27,7 +27,14 @@
 #ifndef GUARD_RADIX_H
 #define GUARD_RADIX_H
 
+// Runtime-compiled kernels must not require a host C++ standard library
+// (see miopen_type_traits.hpp). The runtime-compile path below needs only
+// the fixed-width integer typedefs, provided by miopen_cstdint.hpp.
+#ifdef MIOPEN_HIP_RUNTIME_COMPILE
+#include "miopen_cstdint.hpp"
+#else
 #include <limits>
+#endif
 
 #ifndef MIOPEN_HIP_RUNTIME_COMPILE
 #include <hip/hip_fp16.h>
@@ -64,11 +71,11 @@ __device__ inline Radix encode(DTYPE v)
     }
     else if constexpr(std::is_same<int32_t, DTYPE>::value)
     {
-        return static_cast<Radix>(std::numeric_limits<int32_t>::max()) + v + 1;
+        return static_cast<Radix>(__INT32_MAX__) + v + 1;
     }
     else if constexpr(std::is_same<int64_t, DTYPE>::value)
     {
-        return static_cast<Radix>(std::numeric_limits<int64_t>::max()) + v + 1;
+        return static_cast<Radix>(__INT64_MAX__) + v + 1;
     }
     // bfloat16 is passed as ushort in kernel
     else if constexpr(std::is_same<ushort, DTYPE>::value)
