+#pragma once
+
+/// \file Freestanding std::forward for MIOpen runtime-compiled kernels.
+///
+/// Included by miopen_utility.hpp ONLY when kernels are compiled at
+/// runtime (MIOPEN_HIP_RUNTIME_COMPILE) on HIP >= 7.0 AND no real
+/// <utility> is reachable (__has_include probe) — mirroring
+/// miopen_freestanding_type_traits.hpp. See that file for the
+/// coexistence rationale (rocm-libraries#7718 failure class).
+
+#ifndef MIOPEN_HIP_RUNTIME_COMPILE
+#error "miopen_freestanding_utility.hpp is for runtime-compiled kernels only"
+#endif
+
+#include "miopen_type_traits.hpp" // std::remove_reference (probe-consistent)
+
+namespace std {
+
+template <typename T>
+constexpr T&& forward(typename remove_reference<T>::type& t_) noexcept
+{
+    return static_cast<T&&>(t_);
+}
+
+template <typename T>
+constexpr T&& forward(typename remove_reference<T>::type&& t_) noexcept
+{
+    return static_cast<T&&>(t_);
+}
+
+} // namespace std
diff --git a/projects/miopen/src/kernels/miopen_type_traits.hpp b/projects/miopen/src/kernels/miopen_type_traits.hpp
index e2b6a98e..71b64ed0 100644
--- a/projects/miopen/src/kernels/miopen_type_traits.hpp
+++ b/projects/miopen/src/kernels/miopen_type_traits.hpp
@@ -25,8 +25,8 @@
  *******************************************************************************/
 #pragma once
 
-#if HIP_PACKAGE_VERSION_FLAT < 7000000000ULL
 #ifdef MIOPEN_HIP_RUNTIME_COMPILE
+#if HIP_PACKAGE_VERSION_FLAT < 7000000000ULL
 
 namespace std {
 
@@ -144,9 +144,23 @@ using conditional_t = typename conditional<predicate, X, Y>::type;
 } // namespace std
 #else
 
+// HIP >= 7: runtime compilation may run where no host C++ standard library
+// is installed (e.g. ROCm Windows wheels without MSVC). Prefer the real
+// <type_traits> whenever it is reachable; otherwise fall back to MIOpen's
+// freestanding traits so runtime-compiled kernels stay self-contained.
+#if __has_include(<type_traits>)
 #include <type_traits> // std::remove_reference, std::remove_cv, is_pointer
+#else
+#if __has_include(<utility>)
+#error \
+    "inconsistent C++ standard library availability: <type_traits> is not reachable but <utility> is; provide a complete standard library (or none)"
+#endif
+#include "miopen_freestanding_type_traits.hpp"
+#endif
 
 #endif
 #else
-#include <type_traits>
+
+#include <type_traits> // std::remove_reference, std::remove_cv, is_pointer
+
 #endif
diff --git a/projects/miopen/src/kernels/miopen_utility.hpp b/projects/miopen/src/kernels/miopen_utility.hpp
index 156cb30f..44ab2c40 100644
--- a/projects/miopen/src/kernels/miopen_utility.hpp
+++ b/projects/miopen/src/kernels/miopen_utility.hpp
@@ -25,8 +25,8 @@
  *******************************************************************************/
 #pragma once
 
-#if HIP_PACKAGE_VERSION_FLAT < 7000000000ULL
 #ifdef MIOPEN_HIP_RUNTIME_COMPILE
+#if HIP_PACKAGE_VERSION_FLAT < 7000000000ULL
 
 #include "miopen_type_traits.hpp" // std::remove_reference
 
@@ -48,9 +48,23 @@ constexpr T&& forward(typename remove_reference<T>::type&& t_) noexcept
 
 #else
 
+// HIP >= 7: runtime compilation may run where no host C++ standard library
+// is installed (e.g. ROCm Windows wheels without MSVC). Prefer the real
+// <utility> whenever it is reachable; otherwise fall back to MIOpen's
+// freestanding forward so runtime-compiled kernels stay self-contained.
+#if __has_include(<utility>)
 #include <utility>
+#else
+#if __has_include(<type_traits>)
+#error \
+    "inconsistent C++ standard library availability: <utility> is not reachable but <type_traits> is (a partial freestanding override on the include path?); provide a complete standard library (or none)"
+#endif
+#include "miopen_freestanding_utility.hpp"
+#endif
 
 #endif
 #else
+
 #include <utility>
+
 #endif
