# General normalization to LF in-repo.
* text=auto
*.py text
*.ps1 text
*.md text
*.json text

# Checksum file must be LF so `sha256sum -c` works on POSIX.
evidence/SHA256SUMS.txt text eol=lf

*.png binary
*.jpg binary

# LAST (overrides the general rules above): raw evidence must be committed
# byte-exact — its SHA256s are recorded in evidence/SHA256SUMS.txt — so no
# EOL conversion or normalization of any kind.
evidence/raw/** -text
# Phase-2 raw evidence: same byte-exact rule as Phase 1 (hashes recorded in
# evidence/phase2/SHA256SUMS.txt by Gate 43).
evidence/phase2/** -text
